# Required backend configuration. Never commit the real values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
OPENAI_API_KEY=your-openai-api-key
FLASK_SECRET_KEY=generate-a-long-random-value

# Comma-separated frontend origins allowed to send authenticated requests.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Use development locally so cookies work over http://localhost.
FLASK_ENV=development
